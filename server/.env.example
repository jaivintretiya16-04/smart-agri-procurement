# Smart Agricultural Procurement & Queue Management System
# Backend Environment Configuration Example

# Server Port & Mode
PORT=5000
NODE_ENV=development

# Database Configuration (Neon Cloud PostgreSQL or Local PostgreSQL)
# Example Cloud (Neon): postgresql://user:password@ep-sample-123.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Example Dedicated Local: postgres://postgres:password@127.0.0.1:54329/agri_procure
DATABASE_URL=
DATABASE_URL_DEMO=

# JWT Authentication
JWT_SECRET=replace_with_secure_random_64_character_string_for_production
JWT_EXPIRES_IN=7d

# Frontend CORS Origin
FRONTEND_URL=http://localhost:5173

# Background Cron & Outbox Worker Secret
CRON_SECRET=replace_with_secure_cron_token

# Demo Scenario Simulation Mode
DEMO_MODE=false

# Transactional Email (Optional - Brevo / Sendinblue API)
BREVO_API_KEY=
EMAIL_FROM=notifications@agriprocure.local
